# ---------------------------------------------------------------------------
# AUTOMATIZE — environment configuration
#
# Copy to `.env` and fill in. NEVER commit a filled-in .env.
# Every variable is validated at boot by src/lib/env.ts — the app refuses to
# start with an invalid configuration rather than failing later at runtime.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development

# Canonical public origin. Used for callbacks, canonical URLs, sitemap and
# Server Action origin checks. No trailing slash.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL=postgresql://automatize:automatize@localhost:5432/automatize?schema=public

# --- Session / crypto -------------------------------------------------------
# 32+ byte random secret. Generate with: openssl rand -base64 48
# Used to derive the HMAC key that fingerprints session tokens at rest.
SESSION_SECRET=

# --- Payments (Stripe) ------------------------------------------------------
# Leave blank to run without a payment provider: checkout then refuses to
# create real orders instead of pretending a payment succeeded.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret from the Stripe CLI or dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Platform commission in basis points (1500 = 15%, matching the published rate).
PLATFORM_FEE_BPS=1500

# --- Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) ------------------
# Leave STORAGE_DRIVER=local for development without object storage.
# Values: local | s3
STORAGE_DRIVER=local
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET_PRIVATE=
S3_BUCKET_PUBLIC=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public host for product images, used by next/image remotePatterns.
NEXT_PUBLIC_MEDIA_HOST=
# Lifetime of a signed download URL, in seconds.
DOWNLOAD_URL_TTL_SECONDS=300

# --- Rate limiting ----------------------------------------------------------
# `database` shares one counter across every instance and survives restarts —
# the only correct choice on serverless, where `memory` gives an attacker a
# fresh window on every cold start and enforces almost nothing.
# `memory` is fine for local development against a single long-lived process.
RATE_LIMIT_DRIVER=database
REDIS_URL=

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info
# Sentry DSN. Leave blank to run without error reporting — captureError()
# never imports the SDK, let alone calls it. Server + edge runtime only, no
# browser SDK, so setting this does not require a CSP change.
SENTRY_DSN=
